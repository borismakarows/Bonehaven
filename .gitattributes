# Auto-detect text files and normalize line endings to LF in Git repository
* text=auto

# Unity Text Assets & Input Actions (Keep LF normalized)
*.inputactions text eol=lf
*.cs text diff=csharp eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Unity YAML / Serialized Text Assets
*.mat text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.guiskin text eol=lf
*.g立て text eol=lf

# Binary Assets (Prevent line ending conversion entirely)
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.so binary
*.dylib binary
*.ttf binary
*.otf binary