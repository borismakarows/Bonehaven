    <ui:VisualElement name="Container" style="flex-grow: 1; width: 1920px; height: 1080px; aspect-ratio: auto; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Textures/parchment-paper-illustration-isolated.png?fileID=2800000&amp;guid=f0dcaf7f44faf03418285871bb5228f3&amp;type=3#parchment-paper-illustration-isolated&quot;);">
